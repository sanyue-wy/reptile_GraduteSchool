{
  "name": "table_component",
  "version": "1.0.0",
  "author": "maintainers",
  "plugin_type": "ui",
  "input_schema": "ViewModel.v1",
  "output_schema": "UIComponentDTO.v1",
  "entry_point": "plugins.ui.table_component.plugin:TableComponentPlugin",
  "dependencies": [],
  "min_core_version": "3.0.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "columns": {
        "type": "array",
        "items": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {
              "type": "object",
              "properties": {
                "field": {"type": "string", "minLength": 1},
                "label": {"type": "string"},
                "type": {"type": "string", "enum": ["string", "integer", "number", "boolean", "date", "datetime"]},
                "sortable": {"type": "boolean", "default": true},
                "formatter": {"type": ["string", "null"]},
                "align": {"type": "string", "enum": ["left", "center", "right"], "default": "left"},
                "width": {"type": ["integer", "string", "null"]}
              },
              "required": ["field"],
              "additionalProperties": false
            }
          ]
        },
        "description": "Column definitions (field names or full definitions)"
      },
      "sortable": {"type": "boolean", "default": true},
      "pagination": {"type": "boolean", "default": true},
      "page_size": {"type": "integer", "minimum": 1, "maximum": 500, "default": 50},
      "striped": {"type": "boolean", "default": true},
      "hoverable": {"type": "boolean", "default": true},
      "bordered": {"type": "boolean", "default": false}
    },
    "additionalProperties": false
  },
  "license": "MIT"
}
