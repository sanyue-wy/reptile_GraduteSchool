{
  "name": "markdown_presenter",
  "version": "1.0.0",
  "author": "maintainers",
  "plugin_type": "presenter",
  "input_schema": "PresentationRequest.v1",
  "output_schema": "RenderedOutputDTO.v1",
  "entry_point": "plugins.presenters.markdown_presenter.plugin:MarkdownPresenterPlugin",
  "dependencies": [],
  "min_core_version": "3.0.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": ["table", "list"],
        "default": "table",
        "description": "Markdown layout: 'table' for pipe table, 'list' for headed sections"
      },
      "output_dir": {
        "type": "string",
        "description": "Optional output directory for rendered files"
      }
    },
    "additionalProperties": false
  },
  "license": "MIT"
}
