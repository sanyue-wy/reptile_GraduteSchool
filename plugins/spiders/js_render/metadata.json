{
  "name": "js_render",
  "version": "1.0.0",
  "author": "maintainers",
  "plugin_type": "spider",
  "input_schema": "TaskConfigDTO.v1",
  "output_schema": "RawDataBatch.v1",
  "entry_point": "plugins.spiders.js_render.plugin:JSRenderSpiderPlugin",
  "dependencies": ["requests", "beautifulsoup4"],
  "optional_dependencies": ["playwright"],
  "min_core_version": "3.0.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "max_pages": {"type": "integer", "minimum": 1, "maximum": 20, "default": 5},
      "delay": {"type": "number", "minimum": 1.0, "maximum": 30.0, "default": 3.0},
      "timeout": {"type": "integer", "minimum": 5000, "maximum": 120000, "default": 30000},
      "wait_selector": {"type": "string"}
    },
    "additionalProperties": false
  }
}